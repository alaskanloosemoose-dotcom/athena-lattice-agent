# Copy to .env and edit. Everything here is optional.

# Who Athena talks to: she uses your name and knows where you live.
ATHENA_USER_NAME=
ATHENA_USER_PLACE=

# Chat model (an Ollama model name). The default is uncensored; see the README.
# Standard version: hf.co/mradermacher/DeepSeek-V4-Pro-Qwen3.5-9B-GGUF:Q6_K
# ATHENA_MODEL=dsv4-heretic

# Image model (a Hugging Face repo in mflux format).
# ATHENA_IMAGE_MODEL=Runpod/FLUX.2-klein-4B-mflux-4bit

# Where the conversation and paintings are kept.
# ATHENA_DATA_DIR=./data

# Ollama server and web port.
# OLLAMA_URL=http://127.0.0.1:11434
# ATHENA_PORT=8501
